# DockLens 部署配置示例
# 通常只需要修改 DOCKLENS_BIND 和 DOCKLENS_PORT，其余保持默认即可。
# 复制为 .env：cp .env.example .env

# 镜像仓库地址，不要带 tag；tag 由 DOCKLENS_VERSION 决定。
DOCKLENS_IMAGE=ghcr.io/marod1m/docklens
DOCKLENS_VERSION=0.0.1

# 面板监听地址。
# 0.0.0.0 表示允许局域网访问；仅本机访问请改为 127.0.0.1。
DOCKLENS_BIND=0.0.0.0
DOCKLENS_PORT=7577

# 时区
TZ=Asia/Shanghai

# 元数据目录，保存隐藏、收藏、标签和设置
DOCKLENS_DATA_DIR=./data

# 自动扫描间隔，单位秒
DOCKLENS_REFRESH=30

# 多网卡或 VPN 环境下指定首选宿主机 IP，留空自动选择
DOCKLENS_HOST_IP=
